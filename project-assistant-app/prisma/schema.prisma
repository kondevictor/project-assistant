// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NOTE: status/priority/stage fields below are plain Strings constrained to a
// fixed set of values in application code (see src/lib/constants.ts). This
// keeps the schema portable if we later promote them to real enums.

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  imageUrl      String?
  role          String?   // freelancer, consultant, developer, project_manager, executive, student
  onboardingComplete Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  tasks         Task[]    @relation("TaskOwner")
  assignedTasks Task[]    @relation("TaskAssignee")
  notes         Note[]
  stakeholders  Stakeholder[]
  meetings      Meeting[] @relation("MeetingOrganizer")
  attendedMeetings MeetingAttendee[]
  notifications Notification[]
  projectEvents ProjectEvent[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  // ProjectStage: "INCEPTION" | "PLANNING" | "EXECUTION" | "REVIEW" | "COMPLETED" | "ON_HOLD"
  stage       String    @default("INCEPTION")
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])

  phases      Phase[]
  tasks       Task[]
  notes       Note[]
  stakeholders Stakeholder[]
  meetings    Meeting[]
  events      ProjectEvent[]
  stakeholderTasks StakeholderTask[]
  generatedDocuments GeneratedDocument[]

  @@index([ownerId])
}

model Phase {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  name        String
  isMilestone Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       Task[]

  @@index([projectId])
}

model Task {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  phase     Phase?  @relation(fields: [phaseId], references: [id])
  phaseId   String?

  title       String
  description String?
  ownerId     String?
  owner       User?   @relation("TaskOwner", fields: [ownerId], references: [id])
  assigneeId  String?
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // TaskStatus: "NOT_STARTED" | "IN_PROGRESS" | "BLOCKED" | "DONE" | "CANCELLED"
  status String @default("NOT_STARTED")
  // Priority: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  priority String @default("MEDIUM")

  dueDate       DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  blockedReason String?

  // Updated only when `status` changes (not on every edit) — drives stalled-task detection.
  lastStatusChangeAt DateTime @default(now())

  source   Source? @relation(fields: [sourceId], references: [id])
  sourceId String?

  notes Note[]

  stakeholderId String?
  stakeholder   Stakeholder? @relation("TaskStakeholder", fields: [stakeholderId], references: [id])

  dependsOn TaskDependency[] @relation("DependentTask")
  blocks    TaskDependency[] @relation("BlockingTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([status])
  @@index([dueDate])
  @@index([ownerId])
  @@index([assigneeId])
}

// Explicit join model for task dependencies: `blockingTask` must complete
// before `dependentTask` can proceed.
model TaskDependency {
  id String @id @default(cuid())

  blockingTask   Task   @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockingTaskId String

  dependentTask   Task   @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  dependentTaskId String

  createdAt DateTime @default(now())

  @@unique([blockingTaskId, dependentTaskId])
}

model Note {
  id        String   @id @default(cuid())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String?

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  body      String

  source    Source?  @relation(fields: [sourceId], references: [id])
  sourceId  String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([authorId])
}

// Provenance for any Task/Note. MVP only ever creates SourceType "MANUAL",
// but this is the extension point for future document/meeting/calendar ingestion.
model Source {
  id        String   @id @default(cuid())

  // SourceType: "MANUAL" | "DOCUMENT" | "MEETING" | "CALENDAR"
  type        String  @default("MANUAL")
  label       String?
  externalRef String?
  rawContent  String?

  createdAt   DateTime @default(now())

  tasks Task[]
  notes Note[]
}

// Stakeholder model for project stakeholders with contact details
model Stakeholder {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  name        String
  email       String?
  phone       String?
  company     String?
  role        String   // stakeholder, team_member, partner, facilitator, investor, developer, manufacturer, supplier
  notes       String?

  meetingAttendees MeetingAttendee[]
  stakeholderTasks StakeholderTask[]
  assignedTasks    Task[]            @relation("TaskStakeholder")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([email])
}

// Meeting model for scheduling meetings
model Meeting {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  organizerId String
  organizer   User     @relation("MeetingOrganizer", fields: [organizerId], references: [id])

  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?      // Physical location or "Online"
  meetingUrl  String?      // Google Meet/Zoom link
  meetingType String?      // "google_meet", "zoom", "teams", "in_person"
  status      String  @default("scheduled") // scheduled, in_progress, completed, cancelled

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees   MeetingAttendee[]
  transcription Transcription?

  @@index([projectId])
  @@index([organizerId])
  @@index([startTime])
  @@index([status])
}

// Meeting attendees (many-to-many between Meeting and User/Stakeholder)
model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  stakeholderId String?
  stakeholder   Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  status    String   @default("pending") // pending, accepted, declined, tentative

  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@unique([meetingId, stakeholderId])
  @@index([meetingId])
  @@index([userId])
  @@index([stakeholderId])
}

// Meeting transcription
model Transcription {
  id        String   @id @default(cuid())
  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  audioUrl  String?      // URL to audio recording
  transcript String?     // Full transcript text
  summary   String?      // AI-generated summary
  actionItems String?    // Extracted action items
  language  String  @default("en")
  duration  Int?         // Duration in seconds
  status    String  @default("processing") // processing, completed, failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // email, in_app, push
  title     String
  message   String
  data      Json?    // Additional data (meetingId, taskId, etc.)
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// Project Events - track updates and milestones
model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  type      String   // status_change, milestone_reached, stakeholder_added, meeting_scheduled, custom
  title     String
  description String?
  metadata  Json?    // Additional event data

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// Stakeholder Tasks - tasks assigned to stakeholders with deadlines
model StakeholderTask {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholderId  String
  stakeholder    Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  status         String   @default("pending") // pending, in_progress, completed, overdue
  priority       String   @default("medium")  // low, medium, high, critical
  dueDate        DateTime?
  completedAt    DateTime?
  reminderSent   Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@index([stakeholderId])
  @@index([dueDate])
  @@index([status])
}

// Document Templates
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   // ncnda, mou, mandate, partnership
  description String?
  content     String   // Template content with placeholders
  documents   GeneratedDocument[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Generated Documents
model GeneratedDocument {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId  String
  template    DocumentTemplate @relation(fields: [templateId], references: [id])

  fileName    String
  fileUrl     String?
  status      String   @default("pending") // pending, generated, downloaded

  metadata    Json?    // Additional document data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([templateId])
}
